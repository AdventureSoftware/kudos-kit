# Kudos Kit settings for docker compose. Create the real file with:
#   ./scripts/setup.sh your.domain
# which copies this file to .env and fills in every "generated" value with a random secret.
# Keep .env private: it is in .gitignore and must never be committed.

# --- Address -----------------------------------------------------------------------
# Where the dashboard, the API and the widget script are served (no https://, no slash).
DOMAIN=feedback.example.com

# --- Home page ---------------------------------------------------------------------
# Visitors who aren't signed in see a page introducing Kudos Kit at https://DOMAIN/.
# Set to false to send them straight to the sign-in page instead.
LANDING_PAGE=

# --- Secrets (generated by setup.sh) ------------------------------------------------
POSTGRES_PASSWORD=generated
DB_INGEST_PASSWORD=generated
DB_ADMIN_PASSWORD=generated
# Signs login sessions. Changing it signs everyone out.
BETTER_AUTH_SECRET=generated

# --- Reverse proxy ------------------------------------------------------------------
# Server with nginx already: leave COMPOSE_PROFILES empty and use deploy/nginx/kudoskit.conf.
# Server without one: set COMPOSE_PROFILES=caddy and Caddy handles HTTPS by itself.
COMPOSE_PROFILES=
# Local ports nginx forwards to (only reachable from the server itself).
SERVER_PORT=3100
CLIENT_PORT=3101

# --- Spam protection (Cloudflare Turnstile) -----------------------------------------
# dash.cloudflare.com -> Turnstile -> Add widget, with the domains of the sites that use the
# widget AND your DOMAIN. Without these, the dashboard's Widget page uses Cloudflare's test key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Email (Brevo) ------------------------------------------------------------------
# Invitations, password resets and new-feedback alerts. Without these, links are written
# to the server log instead (docker compose logs server).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
# Who gets the new-feedback alerts.
BREVO_TO_EMAIL=

# --- Google / Apple sign-in (optional, see docs/sign-in-providers.md) -----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The key file goes in ./secrets/ on the server; this is its path inside the container.
APPLE_PRIVATE_KEY_PATH=
# e.g. APPLE_PRIVATE_KEY_PATH=/app/secrets/AuthKey_ABC123DEFG.p8

# --- Privacy page (https://DOMAIN/privacy) ------------------------------------------
PRIVACY_OPERATOR=
PRIVACY_CONTACT_EMAIL=
PRIVACY_HOSTING=
PRIVACY_AUTHORITY=
# Feedback is deleted after this many days (0 = keep until deleted by hand).
FEEDBACK_RETENTION_DAYS=90
