generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  key      String     @id
  name     String
  active   Boolean    @default(true)
  feedback Feedback[]

  @@map("projects")
}

model Feedback {
  id           BigInt    @id @default(autoincrement())
  project      String
  type         String
  message      String
  email        String?
  user_ctx     Json?
  context      Json?
  console_logs Json?
  errors       Json?
  status       String    @default("new")
  ip           Unsupported("inet")?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  projectRef   Project   @relation(fields: [project], references: [key])

  @@index([project, status, created_at(sort: Desc)])
  @@map("feedback")
}
