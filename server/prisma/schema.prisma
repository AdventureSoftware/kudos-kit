generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  key         String     @id
  name        String
  active      Boolean    @default(true)
  /// Short code used in feedback references, e.g. "CP" in CP-12. Set by db/002_project_refs.sql.
  prefix      String     @unique
  /// Next per-project feedback number. Managed by a database trigger; never set it from the app.
  next_number Int        @default(1)
  feedback    Feedback[]

  @@map("projects")
}

model Feedback {
  id           BigInt    @id @default(autoincrement())
  project      String
  /// Per-project sequence number (CP-12 -> 12). Assigned by a database trigger on insert.
  number       Int
  type         String
  message      String
  email        String?
  user_ctx     Json?
  context      Json?
  console_logs Json?
  errors       Json?
  status       String    @default("new")
  ip           Unsupported("inet")?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  projectRef   Project   @relation(fields: [project], references: [key])

  @@unique([project, number])
  @@index([project, status, created_at(sort: Desc)])
  @@map("feedback")
}
