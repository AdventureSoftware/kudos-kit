# server/.env.example: settings for LOCAL DEVELOPMENT. Copy to server/.env and fill in.
# On a server with Docker, settings come from the root .env instead (see /.env.example, DEPLOY.md).

PORT=3000

# Local PostgreSQL. Create the roles with these passwords:
#   PGDATABASE=feedback DB_INGEST_PASSWORD=dev-ingest DB_ADMIN_PASSWORD=dev-admin sh db/migrate.sh
DB_HOST=localhost
DB_PORT=5432
DB_NAME=feedback
DB_INGEST_USER=feedback_ingest
DB_INGEST_PASSWORD=dev-ingest
DB_ADMIN_USER=feedback_admin
DB_ADMIN_PASSWORD=dev-admin
DATABASE_URL=postgresql://feedback_admin:dev-admin@localhost:5432/feedback

# The dashboard's address (links in emails, sign-in redirects).
ADMIN_URL=http://localhost:3001
# Signs login sessions, at least 32 characters:  openssl rand -hex 32
BETTER_AUTH_SECRET=

# Cloudflare's test secret: every spam check passes. Use a real one in production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Email (optional locally: without it, invite/reset links are printed in this terminal).
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_TO_EMAIL=

# Google / Apple sign-in (optional, see docs/sign-in-providers.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

FEEDBACK_RETENTION_DAYS=90
