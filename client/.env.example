# client/.env.example: settings for LOCAL DEVELOPMENT. Copy to client/.env.local.
# On a server with Docker, these come from the root .env instead (see /.env.example).

# Where the dashboard reaches the API.
NESTJS_API_URL=http://localhost:3000

# Cloudflare Turnstile site key for the widget. Empty = Cloudflare's test key (always passes).
TURNSTILE_SITE_KEY=

# Shown on the public /privacy page.
PRIVACY_OPERATOR=
PRIVACY_CONTACT_EMAIL=
PRIVACY_HOSTING=
PRIVACY_AUTHORITY=
